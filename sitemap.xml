<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>{{ site.github.url }}/Petal-and-prose/</loc>
  
  {% for novel in site.pages %}
    {% if novel.path contains 'novels/' and novel.status == 'Published' %}
      <url>
        <loc>{{ site.github.url }}/Petal-and-prose{{ novel.url }}</loc>
    {% endif %}
  {% endfor %}

</urlset>
